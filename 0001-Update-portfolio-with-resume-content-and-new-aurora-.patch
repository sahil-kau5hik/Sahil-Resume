+/* ============================================
+   Theme refresh: Aurora (indigo → sky → teal, amber accent)
+   ============================================ */
+:root {
+    --gradient-primary: linear-gradient(135deg, #6366f1 0%, #0ea5e9 55%, #14b8a6 100%);
+    --gradient-neon: linear-gradient(135deg, #14b8a6 0%, #0ea5e9 50%, #6366f1 100%);
+    --gradient-strong: linear-gradient(135deg, #6366f1 0%, #0ea5e9 50%, #14b8a6 100%);
+    --gradient-hero: linear-gradient(135deg, #6366f1 0%, #0ea5e9 50%, #14b8a6 100%);
+    --gradient-secondary: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
+    --gradient-skill: linear-gradient(135deg, #14b8a6 0%, #0ea5e9 100%);
+    --gradient-cert: linear-gradient(135deg, #a5b4fc 0%, #5eead4 100%);
+    --bg-secondary: #f1f5fb;
+    --bg-dark: #0a0f1f;
+    --font-primary: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+    --font-secondary: 'Space Grotesk', 'DM Sans', sans-serif;
+}
+
+.navbar { border-bottom: 2px solid transparent; border-image: var(--gradient-neon) 1; }
+.section:nth-child(even) { background: linear-gradient(180deg, #f1f5fb 0%, #e8f1fb 100%); }
+.footer { border-top: 4px solid transparent; border-image: var(--gradient-neon) 1; }
+.badge-pursuing { background: var(--gradient-neon); }
+.certification-card.featured-cert .cert-detail { color: var(--text-secondary); }
+
+/* Dark aurora hero */
+.hero { background: #0a0f1f; isolation: isolate; }
+.hero-background {
+    opacity: 1;
+    background:
+        radial-gradient(60% 50% at 15% 20%, rgba(99, 102, 241, 0.55), transparent 70%),
+        radial-gradient(50% 45% at 85% 25%, rgba(14, 165, 233, 0.45), transparent 70%),
+        radial-gradient(55% 50% at 60% 95%, rgba(20, 184, 166, 0.40), transparent 70%),
+        #0a0f1f;
+}
+.hero-background::before { display: none; }
+.hero-background::after { background: none; }
+.hero .greeting { color: #a9b6d6; }
+.hero .name { filter: none; font-size: clamp(2.5rem, 7vw, 4.5rem); letter-spacing: -0.02em; }
+.hero .hero-subtitle { color: #ffffff; text-shadow: none; }
+.hero .hero-tagline, .hero .hero-location { color: #b9c5df; }
+.hero .hero-contact a, .hero .social-link {
+    background: rgba(255, 255, 255, 0.08);
+    color: #e5ebf7;
+    border-color: rgba(255, 255, 255, 0.16);
+}
+.hero .scroll-indicator a { color: #5eead4; }
